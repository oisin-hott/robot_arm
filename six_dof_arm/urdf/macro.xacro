<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="six_dof_arm">
  
  <!-- ================= LINK MACRO ================= -->
  <xacro:macro name="cylinder_link" params="name length link_radius">

    <link name="${name}">

      <visual>
      <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${link_radius}" length="${length}"/>
        </geometry>
  
      </visual>

      <collision>
        <geometry>

          <cylinder radius="${link_radius}" length="${length}"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="1.0"/>
        <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
        <inertia ixx="0.01" iyy="0.01" izz="0.01"
                 ixy="0" ixz="0" iyz="0"/>
      </inertial>

    </link>

  </xacro:macro>


<xacro:macro name="box_link" params="name length width height">

  <link name="${name}">

    <visual>
      <!-- Shift geometry so link starts at joint -->
      <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
      <geometry>
        <!-- Keep your orientation -->
        <box size="${height} ${width} ${length}"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
      <geometry>
        <!-- MUST match visual -->
        <box size="${height} ${width} ${length}"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="1.0"/>

      <!-- Match visual + collision -->
      <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>

      <inertia
        ixx="${(1/12) * 1.0 * (width*width + height*height)}"
        iyy="${(1/12) * 1.0 * (length*length + height*height)}"
        izz="${(1/12) * 1.0 * (length*length + width*width)}"
        ixy="0" ixz="0" iyz="0"/>
    </inertial>

  </link>

</xacro:macro>

  <xacro:macro name="dummy_link" params="name">

    <link name="${name}">

        <inertial>
        <mass value="1.0"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.01" iyy="0.01" izz="0.01"
                 ixy="0" ixz="0" iyz="0"/>
      </inertial>

    </link>

  </xacro:macro>


<xacro:macro name="mesh_link" params="name mesh_file origin_xyz origin_rpy mass ixx ixy ixz iyy iyz izz">
  <link name="${name}">
    <self_collide>1</self_collide>
    <visual>
      <origin xyz="${origin_xyz}" rpy="${origin_rpy}"/>
      <geometry>
        <mesh filename="${mesh_file}" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="${origin_xyz}" rpy="${origin_rpy}"/>
      <geometry>
        <mesh filename="${mesh_file}" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="${ixx}" ixy="${ixy}" ixz="${ixz}"
               iyy="${iyy}" iyz="${iyz}"
               izz="${izz}"/>
    </inertial>
  </link>
  <gazebo reference="${name}">
      <visual>
        <material>
          <ambient>0.3 0.3 0.35 1</ambient>
          <diffuse>0.7 0.7 0.7 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </gazebo>

</xacro:macro>

  <!-- ================= JOINT MACRO ================= -->
  <xacro:macro name="arm_joint" params="name parent child axis xyz">

    <joint name="${name}" type="revolute">
      <parent link="${parent}"/>
      <child link="${child}"/>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <axis xyz="${axis}"/>

      <limit lower="-3.14" upper="3.14" effort="10" velocity="1.0"/>
    </joint>

  </xacro:macro>

  </robot>